# ===== Trợ lý AI chat (POST /api/chat) — copy thành server/.env rồi điền =====
# Lấy API key tại https://xkiro.com (đăng ký → Create an API key).
# Gói Free: 500.000 token/ngày + 37 model miễn phí — dư dùng cho chat shop.
# Để trống XKIRO_API_KEY → chat tự chạy chế độ "fallback" (rule-based),
# web vẫn hoạt động bình thường.

XKIRO_API_KEY=

# Model trên xKiro (bảng giá/model: https://xkiro.com/models — đổi chỉ bằng biến này)
# Gợi ý cho chat tiếng Việt, miễn phí: qwen/qwen3.5-flash:free · qwen/qwen3.7-flash:free
XKIRO_MODEL=qwen/qwen3.5-flash:free

# Endpoint API (mặc định ổn định — chỉ đổi khi xKiro nâng phiên bản)
# XKIRO_API_BASE=https://api.xkiro.com/v1

# Thời gian tối đa chờ xKiro trả lời (ms)
# XKIRO_TIMEOUT_MS=20000

# Giới hạn tin nhắn chat / phút / IP (riêng cho /api/chat)
# CHAT_RATE_MAX=12

# ===== SQL Server Express — Windows Authentication =====
# SSMS chỉ là công cụ quản trị; Node kết nối trực tiếp tới instance này.
DB_SERVER=.\SQLEXPRESS
# Nếu SQL Browser bị tắt, đặt DB_SERVER=localhost và mở comment port tĩnh:
# DB_PORT=1433
DB_NAME=DoCuQuangHuy
DB_AUTH_MODE=windows
DB_DRIVER=msnodesqlv8
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=true
# Chỉ local dev với certificate tự ký; production bắt buộc false.
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT_MS=10000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# ===== Ví dụ SQL Authentication dành riêng cho SQL Server container CI =====
# CI=true
# DB_AUTH_MODE=sql
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=app_runtime_ci
# DB_PASSWORD=<secret GitHub Actions, không commit>
# DB_TRUSTED_CONNECTION=false
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_ALLOW_SELF_SIGNED_CI=true
# CI_SQL_ADMIN_USER=sa
# CI_SQL_ADMIN_PASSWORD=<secret riêng chỉ dùng bootstrap>

# ===== Ví dụ production Docker/Render — SQL Authentication =====
# Không copy nguyên khối này vào .env local. Trên Render, khai báo từng biến trong
# Environment và dùng Secret cho DB_PASSWORD/XKIRO_API_KEY. Không commit giá trị thật.
# NODE_ENV=production
# DB_AUTH_MODE=sql
# DB_SERVER=<hostname TCP công khai/private network mà Render truy cập được>
# DB_PORT=1433
# DB_NAME=DoCuQuangHuy
# DB_USER=<runtime login quyền tối thiểu>
# DB_PASSWORD=<secret chỉ lưu trên hosting>
# DB_TRUSTED_CONNECTION=false
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_DRIVER=tedious
# CORS_ORIGIN=https://<frontend>.vercel.app
# TRUST_PROXY=1
# PORT do Render cấp, không đặt cứng nếu nền tảng không yêu cầu.
# SQL Server production phải có TLS/certificate hợp lệ; không bật ngoại lệ self-signed của CI.

# ===== HTTP production (tuỳ chọn — bỏ trống là dùng mặc định an toàn) =====
# CORS: production bỏ trống = CHỈ same-origin (web + API chạy cùng server).
# Dev (NODE_ENV khác production) bỏ trống = '*' cho tiện gọi thẳng cổng 3000.
# Muốn mở cho domain khác, khai báo origin tuyệt đối, phân tách bằng dấu phẩy:
# CORS_ORIGIN=https://docuquanghuy.vn,https://www.docuquanghuy.vn
# (Production cấm '*'; khai báo sai format sẽ bị từ chối khởi động.)

# Giới hạn request /api mỗi phút mỗi IP:
# RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000

# Riêng POST /api/orders (chống spam đặt đơn):
# ORDER_RATE_MAX=10
# ORDER_RATE_WINDOW_MS=60000
# (Chat đã có CHAT_RATE_MAX ở phần trên.)

# Đặt khi chạy sau reverse proxy (Nginx/Cloudflare) để rate-limit đếm đúng IP khách
# (lấy từ X-Forwarded-For); thường để 1 khi app đứng ngay sau proxy:
# TRUST_PROXY=1
