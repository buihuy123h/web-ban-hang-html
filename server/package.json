{
  "name": "server",
  "version": "1.3.0",
  "private": true,
  "description": "Express REST API cho storefront Đồ Cũ Quang Huy",
  "main": "index.js",
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-port.ps1",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "precompress": "node scripts/precompress.js",
    "test": "node --test",
    "db:migrate": "node database/postgres/apply-schema.js",
    "db:apply-schema": "node database/postgres/apply-schema.js",
    "db:seed": "node database/postgres/seed.js",
    "db:setup": "node database/postgres/apply-schema.js && node database/postgres/seed.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.13.1"
  }
}
