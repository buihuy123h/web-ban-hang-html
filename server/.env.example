# ================================================================
# BACKEND ĐỒ CŨ QUANG HUY — cấu hình môi trường
# Copy file này thành server/.env rồi thay các giá trị trong dấu <...>.
# Không commit server/.env lên GitHub.
# ================================================================

# Supabase > Connect > Connection string > Direct connection
# Dán nguyên chuỗi PostgreSQL, thêm sslmode=require nếu chưa có.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.npikvyzpvrtnykocjwyc.supabase.co:5432/postgres?sslmode=require

# Project URL và Publishable key trong Supabase hiện không được backend này sử dụng.
# Không dán Publishable key vào DATABASE_URL.
# SUPABASE_PROJECT_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY>

# HTTP server
NODE_ENV=production
PORT=3000

# Nếu frontend deploy riêng, nhập origin frontend chính xác, ví dụ:
# CORS_ORIGIN=https://ten-frontend.vercel.app
# Nếu frontend và backend chạy cùng một server, có thể để trống.
CORS_ORIGIN=

# Chat AI là tuỳ chọn; để trống thì website vẫn hoạt động.
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3.5-flash:free
