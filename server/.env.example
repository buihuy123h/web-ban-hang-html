# ===== Trợ lý AI chat (POST /api/chat) — copy thành server/.env rồi điền =====
# Lấy API key tại https://xkiro.com (đăng ký → Create an API key).
# Gói Free: 500.000 token/ngày + 37 model miễn phí — dư dùng cho chat shop.
# Để trống XKIRO_API_KEY → chat tự chạy chế độ "fallback" (rule-based),
# web vẫn hoạt động bình thường.

XKIRO_API_KEY=

# Model trên xKiro (bảng giá/model: https://xkiro.com/models — đổi chỉ bằng biến này)
# Gợi ý cho chat tiếng Việt, miễn phí: qwen/qwen3.5-flash:free · qwen/qwen3.7-flash:free
XKIRO_MODEL=qwen/qwen3.5-flash:free

# Endpoint API (mặc định ổn định — chỉ đổi khi xKiro nâng phiên bản)
# XKIRO_API_BASE=https://api.xkiro.com/v1

# Thời gian tối đa chờ xKiro trả lời (ms)
# XKIRO_TIMEOUT_MS=20000

# Giới hạn tin nhắn chat / phút / IP (riêng cho /api/chat)
# CHAT_RATE_MAX=12

# ===== PostgreSQL / Supabase — kết nối database (server/lib/db.js đọc các biến này) =====
# Nguồn credential runtime duy nhất: dán Session pooler URI từ Supabase Connect,
# dùng login app_runtime riêng và thêm sslmode=require.
#   (Dashboard > Project Settings > Database > Connection string > URI)
#   - Session pooler (server Node dài hạn): ...pooler.supabase.com:5432/postgres
#   - Transaction pooler (serverless):      ...pooler.supabase.com:6543/postgres
# Mật khẩu có ký tự đặc biệt phải URL-encode (chuỗi Supabase cấp đã encode sẵn).
DATABASE_URL=postgresql://postgres@localhost:5432/DoCuQuangHuy

# Production: postgresql://app_runtime.<ref>:<password>@<session-pooler>:5432/postgres?sslmode=require
# verify-ca/verify-full yêu cầu file CA:
# PGSSL_CA=

# Pool / timeout (tuỳ chọn)
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_QUERY_TIMEOUT_MS=15000

# Tự kết nối lại DB khi mất kết nối lúc runtime (chỉ hoạt động sau khi boot thành công):
# pool lỗi → probe lại "SELECT 1" theo backoff luỹ tiến (min → min*2 → … bị chặn bởi max).
# DB_RECONNECT_MIN_MS=2000    # delay probe đầu tiên sau lỗi pool (100–60000 ms)
# DB_RECONNECT_MAX_MS=30000   # trần delay backoff (1000–600000 ms; MIN phải ≤ MAX)

# Quản trị migration/seed dùng MIGRATION_DATABASE_URL đặt tạm trong terminal/secret store,
# tuyệt đối không ghi URL quản trị vào file này. Xem server/docs/DATABASE.md:
#   npm run db:migrate
#   npm run db:seed

# ===== HTTP production (tuỳ chọn — bỏ trống là dùng mặc định an toàn) =====
# CORS: production bỏ trống = CHỈ same-origin (web + API chạy cùng server).
# Dev (NODE_ENV khác production) bỏ trống = '*' cho tiện gọi thẳng cổng 3000.
# Muốn mở cho domain khác, khai báo origin tuyệt đối, phân tách bằng dấu phẩy:
# CORS_ORIGIN=https://docuquanghuy.vn,https://www.docuquanghuy.vn
# (Production cấm '*'; khai báo sai format sẽ bị từ chối khởi động.)

# Giới hạn request /api mỗi phút mỗi IP:
# RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000

# Riêng POST /api/orders (chống spam đặt đơn):
# ORDER_RATE_MAX=10
# ORDER_RATE_WINDOW_MS=60000
# (Chat đã có CHAT_RATE_MAX ở phần trên.)

# Đặt khi chạy sau reverse proxy (Nginx/Cloudflare) để rate-limit đếm đúng IP khách
# (lấy từ X-Forwarded-For); thường để 1 khi app đứng ngay sau proxy:
# TRUST_PROXY=1

# Log vận hành (request logger):
# LOG_SLOW_MS=1000             # ngưỡng đánh dấu request chậm [slow] (50–3600000 ms)
# LOG_QUIET_PATHS=/api/health  # path bỏ log dòng request (phân tách phẩy, khớp chính xác path)

# Production trên hosting (Render/Docker): NODE_ENV=production + DATABASE_URL của Supabase
# (production luôn bắt buộc SSL). Secret chỉ nhập vào dashboard/secret store, không commit.
