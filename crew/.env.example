# =====================================================================
# Crew "Đồ Cũ Quang Huy" — cấu hình model
# Sao chép file này thành:  crew/.env   rồi điền key của bạn.
# Model mặc định lấy đúng bảng AGENTS.md mục 2 — không cần chỉnh gì thêm.
# =====================================================================

# ---- CÁCH 1 (KHUYÊN DÙNG): chỉ cần 1 key cho cả 4 model ----
# Mặc định gọi openrouter.ai (đăng ký key tại https://openrouter.ai/keys).
# Dùng dịch vụ tương thích OpenRouter (vd xkiro): điền thêm OPENROUTER_BASE_URL
# bên dưới — mọi lượt gọi sẽ trỏ sang dịch vụ đó, model ID giữ nguyên.
# Model ID giữ nguyên như AGENTS.md (openai/..., z-ai/..., moonshotai/..., anthropic/...).
OPENROUTER_API_KEY=sk-or-v1-DIEN_KEY_THAT_CUA_BAN_VAO_DAY
# OPENROUTER_BASE_URL=https://api.xkiro.com/v1

# ---- CÁCH 2: gọi thẳng từng nhà cung cấp (không dùng OpenRouter) ----
# Khi đó PHẢI xóa/comment key OpenRouter ở trên, đặt key từng hãng (tên biến
# môi trường theo docs LiteLLM), VÀ chỉnh MODEL_* bên dưới sang định dạng
# LiteLLM tương ứng (ví dụ moonshot/..., z_ai/...).
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Ghi đè model (tùy chọn — mặc định đúng bảng AGENTS.md mục 2) ----
# MODEL_ANALYST=openai/gpt-5.6-terra
# MODEL_BE_CODER=z-ai/glm-5.3
# MODEL_FE_CODER=moonshotai/kimi-k2.7-code
# MODEL_TESTER=anthropic/claude-opus-5
